@model ReparacaoListViewModel
@{ ViewData["Title"] = "Reparações"; }
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Reparações</h3>
        <div class="card-actions">
            <form method="get" class="d-flex flex-wrap gap-2">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm" placeholder="Pesquisar..." />
                <select name="clienteId" class="form-select form-select-sm">
                    <option value="">Cliente</option>
                    @foreach (var c in Model.Clientes) { <option value="@c.Id" selected="@(Model.ClienteId==c.Id)">@c.Nome</option> }
                </select>
                <select name="tecnicoId" class="form-select form-select-sm">
                    <option value="">Técnico</option>
                    @foreach (var t in Model.Tecnicos) { <option value="@t.Id" selected="@(Model.TecnicoId==t.Id)">@t.Nome</option> }
                </select>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Estado</option>
                    @foreach (var e in ReparacaoService.Estados) { <option value="@e" selected="@(Model.Estado==e)">@e</option> }
                </select>
                <button class="btn btn-sm btn-primary" type="submit">Filtrar</button>
            </form>
            <a asp-action="Create" class="btn btn-sm btn-success ms-2">Nova Reparação</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Id</th><th>Cliente</th><th>Equipamento</th><th>Técnico</th><th>Estado</th><th>Data entrada</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Items)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Equipamento?.Cliente?.Nome</td>
                    <td>@r.Equipamento?.TipoEquipamento</td>
                    <td>@(r.Tecnico?.Nome ?? "-")</td>
                    <td><span class="badge bg-blue-lt">@r.Estado</span></td>
                    <td>@r.DataEntrada.ToString("dd/MM/yyyy")</td>
                    <td class="text-end"><a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
