@model Tecnico
@{ ViewData["Title"] = "Ficha do Técnico"; }
<div class="card"><div class="card-body">
<dl class="row">
<dt class="col-3">Nome</dt><dd class="col-9">@Model.Nome</dd>
<dt class="col-3">Email</dt><dd class="col-9">@Model.Email</dd>
<dt class="col-3">Telefone</dt><dd class="col-9">@Model.Telefone</dd>
<dt class="col-3">Especialidade</dt><dd class="col-9">@Model.Especialidade</dd>
<dt class="col-3">Ativo</dt><dd class="col-9">@(Model.Ativo ? "Sim" : "Não")</dd>
</dl>
</div></div>
<div class="card mt-3">
    <div class="card-header"><h3 class="card-title">Reparações atribuídas</h3></div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Id</th><th>Equipamento</th><th>Cliente</th><th>Estado</th><th>Data entrada</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Reparacoes)
            {
                <tr>
                    <td>@r.Id</td>
                    <td>@r.Equipamento?.TipoEquipamento</td>
                    <td>@r.Equipamento?.Cliente?.Nome</td>
                    <td>@r.Estado</td>
                    <td>@r.DataEntrada.ToString("dd/MM/yyyy")</td>
                    <td><a asp-controller="Reparacoes" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary">Ver</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-link">Voltar</a>
</div>
