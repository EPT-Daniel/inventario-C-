@model ClienteListViewModel
@{ ViewData["Title"] = "Clientes"; }
<div class="card">
    <div class="card-header">
        <h3 class="card-title">Clientes</h3>
        <div class="card-actions">
            <form method="get" class="d-flex">
                <input type="text" name="search" value="@Model.Search" class="form-control form-control-sm me-2" placeholder="Pesquisar..." />
                <button class="btn btn-sm btn-primary" type="submit">Pesquisar</button>
            </form>
            <a asp-action="Create" class="btn btn-sm btn-success ms-2">Novo Cliente</a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead><tr><th>Nome</th><th>NIF</th><th>Email</th><th>Telefone</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Items)
            {
                <tr>
                    <td><a asp-action="Details" asp-route-id="@c.Id">@c.Nome</a></td>
                    <td>@c.NIF</td>
                    <td>@c.Email</td>
                    <td>@c.Telefone</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@c.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
